## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

.vs/
AppPackages
*.cache
.editorconfig
*.pfx
*.resw

# Xenon-Fluent runtime data (launcher root coincides with repo root during dev)
/versions/
/.data/
/mods/
/saves/

# Debug / scratch artifacts
_shot.png
build.binlog
xc.stdout.txt
xc.stderr.txt
debug-xamlc.ps1
rebrand-csv.py
rebrand-xaml.py
regen-icons.py
**/xc.out.txt
**/xc.err.txt
