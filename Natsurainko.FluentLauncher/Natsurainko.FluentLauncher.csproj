    <Page Remove="Views\Downloads\ResourceDefaultPage.xaml" />
    <Compile Remove="Views\Downloads\ResourceDefaultPage.xaml.cs" />
    <Page Remove="Views\Downloads\ResourcePage.xaml" />
    <Compile Remove="Views\Downloads\ResourcePage.xaml.cs" />

    <!-- Modpacks navigation -->
