    <Compile Remove="Views\Downloads\Shaders.NavigationPage.xaml.cs" />

    <!-- TexturePacks navigation -->
    <Page Remove="Views\Downloads\TexturePacks.NavigationPage.xaml" />
    <Compile Remove="Views\Downloads\TexturePacks.NavigationPage.xaml.cs" />

    <!--
      Old MC-style ViewModels for the removed pages. These reference CurseForge/Modrinth
      clients that are still in FluentCore, but the pages they back are gone, so we
      strip them from compilation to make sure nothing rebinds to them by accident.
    -->
    <Compile Remove="ViewModels\Downloads\ResourceDefaultViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\ResourceViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\Mods\DefaultViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\Mods\NavigationViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\Modpacks\DefaultViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\Modpacks\NavigationViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\Shaders\DefaultViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\Shaders\NavigationViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\TexturePacks\DefaultViewModel.cs" />
    <Compile Remove="ViewModels\Downloads\TexturePacks\NavigationViewModel.cs" />

    <!--
      Note: Xaml\Templates\{CurseForge,Modrinth}ResourceItemControlTemplate.* and
      Xaml\Selectors\ResourceTemplateSelector.* remain compiled. They reference
      Nrk.FluentCore types that still exist, are loaded by App.xaml's merged
      dictionary, and removing them would cascade into App.xaml's converter
      registrations. They are simply unused after the rebrand.
    -->
  </ItemGroup>

